# .env.example — Making Things Godot MCP
#
# Copy to .env and adjust. Source before launching:
#   set -a; . ./.env; set +a

# === Server transport ===
# stdio (default) for local agents (Cursor, Claude Code, OpenCode).
# http for remote/web clients — binds 127.0.0.1:9090 by default.
# GODOT_MCP_TRANSPORT=stdio
# GODOT_MCP_HTTP_HOST=127.0.0.1
# GODOT_MCP_HTTP_PORT=9090

# === Bridge (addon ↔ server WebSocket) ===
# The Godot addon connects out to this URL. Default: ws://127.0.0.1:9080
# GODOT_MCP_BRIDGE_URL=ws://127.0.0.1:9080

# === Bridge auth (REQUIRED by default — Making Things decision C) ===
# Shared secret for the editor↔server handshake. If unset, the server mints
# ~/.config/making-things-godot/bridge.token (mode 0600) and logs the path.
# Set the same value in the Godot addon dock / editor environment.
GODOT_MCP_BRIDGE_TOKEN=replace-me-with-a-long-random-secret
# GODOT_MCP_BRIDGE_TOKEN_FILE=~/.config/making-things-godot/bridge.token
# Opt out only for tests / explicit insecure local use:
# GODOT_MCP_ALLOW_INSECURE_BRIDGE=1

# === Godot binary (for headless run/capture/export tools) ===
# Use the .NET/mono build for C# projects (decision F):
# GODOT_MCP_GODOT_BIN=$HOME/godot/Godot_v4.7.2-stable_mono_linux_x86_64/Godot_v4.7.2-stable_mono_linux.x86_64

# === Project directory (for runtime/analysis tools) ===
# GODOT_MCP_PROJECT_DIR=/path/to/your/godot/project

# === HTTP auth (required when binding non-loopback) ===
# GODOT_MCP_AUTH_TOKEN=your-secret-token

# === Approval webhook (optional — gates mutating tools behind an external check) ===
# GODOT_MCP_APPROVAL_WEBHOOK=https://your-webhook-url
# GODOT_MCP_APPROVAL_TIMEOUT=30
# GODOT_MCP_APPROVAL_FAIL_OPEN=true
# GODOT_MCP_APPROVAL_REQUIRE=
